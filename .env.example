DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"

# Conexão REST Protheus (TOTVS)
# Ex.: http://servidor:8080/rest
PROTHEUS_BASE_URL="http://localhost:8080/rest"
PROTHEUS_USERNAME="usuario"
PROTHEUS_PASSWORD="senha"
PROTHEUS_CLIENT_ID=""
PROTHEUS_CLIENT_SECRET=""
PROTHEUS_EMPRESA="99"
PROTHEUS_FILIAL="01"

# Endpoints relativos à BASE_URL (ajuste conforme o Adapter REST do ambiente)
PROTHEUS_TOKEN_PATH="/api/oauth2/v1/token"
PROTHEUS_CUSTOMERS_PATH="/clientes"
PROTHEUS_ORDERS_PATH="/pedidos"
